+void
+a31_pmap_checkpoint(uint64_t bytes, uint64_t begin, uint64_t end,
+    uint64_t limit, uint64_t root, uint64_t asids)
+{
+    if (!a31_xnu_pmap_bounds(bytes, begin, end, limit) || end <= begin ||
+        !root || (root & 0x3fff) || !asids || asids > 65536 || (asids & 63)) {
+        a31_string("[A31-XNU] PMAP-BOOTSTRAP-CHECK FAIL\n");
+        a31_return();
+    }
+    a31_hex("XNU_PMAP_MEM_BYTES=", bytes);
+    a31_hex("XNU_PMAP_ALLOC_BEGIN=", begin);
+    a31_hex("XNU_PMAP_ALLOC_END=", end);
+    a31_hex("XNU_PMAP_ALLOC_LIMIT=", limit);
+    a31_hex("XNU_PMAP_ROOT=", root);
+    a31_hex("XNU_PMAP_MAX_ASIDS=", asids);
+    sweet_early_mark(24, "pmap structures initialized");
 }
 
