+static unsigned int
+a31_check_empty_range(vm_map_address_t start, vm_map_address_t end, pmap_paddr_t first)
+{
+	unsigned int pages = 0;
+	if (start < gVirtBase || start >= end || end > VM_MAX_KERNEL_ADDRESS)
+		panic("A31 late virtual range invalid");
+	for (vm_map_address_t va = start; va < end;) {
+		tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+		if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE))
+			panic("A31 late L1 missing");
+		pmap_paddr_t l2_pa = l1 & ARM_TTE_TABLE_MASK;
+		if (!a31_xnu_pmap_bounds(mem_size, l2_pa, l2_pa + ARM_PGBYTES, gPhysBase + mem_size))
+			panic("A31 late L2 outside RAM");
+		tt_entry_t *l2 = (tt_entry_t *)phystokv(l2_pa);
+		tt_entry_t entry = l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		if ((entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK | ARM_DYNAMIC_TABLE_XN)) !=
+		    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE | ARM_DYNAMIC_TABLE_XN))
+			panic("A31 late L3 type/NX mismatch");
+		pmap_paddr_t page_pa = entry & ARM_TTE_TABLE_MASK;
+		if (page_pa < first || !a31_xnu_pmap_bounds(mem_size, page_pa, page_pa + ARM_PGBYTES, avail_start) ||
+		    !a31_xnu_empty_l3((const uint64_t *)phystokv(page_pa), ARM_PGBYTES))
+			panic("A31 late L3 not empty or outside RAM");
+		if (++pages > 32) panic("A31 late leaf count invalid");
+		vm_map_address_t next = (va & ~ARM_TT_L2_OFFMASK) + ARM_TT_L2_SIZE;
+		if (next <= va) panic("A31 late VA overflow");
+		va = next;
+	}
+	return pages;
+}
+#endif
