+
+/* Entry-only build: arm_init stops before rebasing, CPU and VM startup. */
+static unsigned int a31_panicking;
+
+void
+sweet_early_putc(char character)
+{
+    (void)a31_xnu_ring_putc((void *)(uintptr_t)0x4d05f000, 0x40000, character);
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+a31_string(const char *text)
+{
+    while (*text) sweet_early_putc(*text++);
+}
+
+static void
+a31_hex(const char *name, uint64_t value)
+{
+    static const char digits[] = "0123456789abcdef";
+    a31_string(name);
+    a31_string("0x");
+    for (int shift = 60; shift >= 0; shift -= 4)
+        sweet_early_putc(digits[(value >> shift) & 15]);
+    sweet_early_putc('\n');
+}
+
+static __attribute__((noreturn)) void
+a31_return(void)
+{
+    __asm__ volatile("msr daifset, #15" ::: "memory");
+    a31_string("[A31-XNU] RECOVERY REQUEST\n");
+    if (a31_xnu_request_recovery((void *)(uintptr_t)0x10dc00, 0x800)) {
+        register uint64_t function __asm__("x0") = 0x84000009;
+        register uint64_t arg1 __asm__("x1") = 0;
+        register uint64_t arg2 __asm__("x2") = 0;
+        register uint64_t arg3 __asm__("x3") = 0;
+        __asm__ volatile("dsb sy; isb; smc #0"
+            : "+r"(function), "+r"(arg1), "+r"(arg2), "+r"(arg3)
+            : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+                "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+        a31_hex("PSCI_RESET_RETURN=", function);
+    }
+    a31_string("[A31-XNU] RECOVERY FAILED\n");
+    for (;;) __asm__ volatile("wfe");
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+    uint64_t current_el, sctlr, frequency;
+    a31_string("[A31-XNU] C STAGE ");
+    sweet_early_putc((char)('0' + stage % 10));
+    a31_string(": "); a31_string(label); sweet_early_putc('\n');
+    __asm__ volatile("mrs %0, CurrentEL" : "=r"(current_el));
+    __asm__ volatile("mrs %0, SCTLR_EL1" : "=r"(sctlr));
+    __asm__ volatile("mrs %0, CNTFRQ_EL0" : "=r"(frequency));
+    a31_hex("XNU_CURRENT_EL=", current_el >> 2);
+    a31_hex("XNU_SCTLR_EL1=", sctlr);
+    a31_hex("XNU_CNTFRQ=", frequency);
+    if (stage == 1 && current_el == 4 && (sctlr & 1) && frequency == 13000000)
+        a31_string("[A31-XNU] ENTRY-CHECK PASS\n");
+    else a31_string("[A31-XNU] ENTRY-CHECK FAIL\n");
+    a31_return();
+}
+
+void
+sweet_early_panic(const char *format, va_list *arguments)
+{
+    if (a31_panicking) a31_return();
+    a31_panicking = 1;
+    a31_string("[A31-XNU] PANIC: ");
+    if (arguments) {
+        va_list copy;
+        va_copy(copy, *arguments);
+        _doprnt(format, &copy, sweet_early_putc, 16);
+        va_end(copy);
+    } else a31_string(format);
+    sweet_early_putc('\n');
+    a31_return();
+}
+
+void sweet_early_relocate(uint64_t base) { (void)base; a31_return(); }
+void sweet_early_disable(void) { a31_return(); }
+#endif /* A31: deliberately stops before final TTBR1/TTBR0 teardown. */
